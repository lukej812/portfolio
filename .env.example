# All variables are optional. Copy to .env.local for local overrides,
# or set them in Vercel under Project Settings > Environment Variables.

# Canonical URL used for SEO and Open Graph tags (no trailing slash).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub username whose public repos appear in "Open Source & Builds".
# Defaults to the value in content/github.ts.
NEXT_PUBLIC_GITHUB_USERNAME=lukej812

# Optional GitHub token (no scopes needed) to raise the API rate limit
# from 60 to 5,000 requests per hour. Server-side only, never exposed.
GITHUB_TOKEN=

# Optional form endpoint (for example Formspree: https://formspree.io/f/xxxx).
# When empty, the contact form opens the visitor's email app instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Show [ADD: ...] placeholders in production builds. They always show in
# `npm run dev` and are hidden in production unless this is "true".
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
